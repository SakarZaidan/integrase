# Integrase .gitignore
# Polyglot repository: Rust, Go, Python, Node, plus a Tauri/wgpu desktop shell.
# Organised by ecosystem so it stays readable as the tree grows.

# ---------------------------------------------------------------------------
# Project instructions, not project artifacts
# ---------------------------------------------------------------------------
# The originating brief is an instruction to a contributor, not a deliverable.
# It never belongs in version control.
prompt.txt

# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
/target/
**/target/
**/*.rs.bk
*.pdb
# Cargo.lock IS committed. This repository produces binaries and services, and
# reproducible builds matter more than downstream version flexibility. Library
# crates published from here inherit the workspace lockfile for CI only.

# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum
vendor/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
sdist/
wheels/
.venv/
venv/
ENV/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
# uv.lock is committed deliberately, same reasoning as Cargo.lock.

# ---------------------------------------------------------------------------
# Node and the web/WASM target
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
.next/
.nuxt/
.svelte-kit/
.turbo/
*.tsbuildinfo
pkg/
wasm-pack.log

# ---------------------------------------------------------------------------
# Tauri / desktop
# ---------------------------------------------------------------------------
src-tauri/target/
src-tauri/gen/

# ---------------------------------------------------------------------------
# ML artifacts
# ---------------------------------------------------------------------------
# Model weights, checkpoints, and training data do not belong in git. They are
# versioned separately; see subplan 08 for the storage and provenance plan.
*.ckpt
*.safetensors
*.onnx
*.pt
*.pth
/models/
# Calibration data. Not distributed with Integrase: redistribution terms are
# unresolved (NAS copyright) and R-3.3 holds that data licences are checked like
# code licences. See docs/calibration-data.md.
/data/calibration/
/data/raw/
/data/interim/
/data/processed/
mlruns/
wandb/

# ---------------------------------------------------------------------------
# Biosafety screening reference data
# ---------------------------------------------------------------------------
# Curated sequence-of-concern datasets must never be committed to a public
# repository. This is a hard rule, not housekeeping. See subplan 24.
/screening-data/
*.soc
*.soc.gz

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/**/*.pem
!**/testdata/**/*.key
credentials.json
secrets.toml

# ---------------------------------------------------------------------------
# Editors, OS, WSL
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.fuse_hidden*
.Trash-*

# ---------------------------------------------------------------------------
# Build, test, and profiling output
# ---------------------------------------------------------------------------
/coverage/
*.profraw
*.profdata
perf.data*
flamegraph.svg
criterion/
/tmp/
/scratch/
