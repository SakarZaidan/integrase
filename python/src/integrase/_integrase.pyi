"""Type stubs for the Rust extension.

Hand-written because the extension is compiled. Kept in step with
`crates/integrase-py/src/lib.rs`; a test asserts the two agree on the exported
names, so a binding added on one side and forgotten on the other fails the build.
"""

__version__: str

class Interval:
    @property
    def lower(self) -> float: ...
    @property
    def upper(self) -> float: ...
    @property
    def width(self) -> float: ...
    def contains(self, value: float) -> bool: ...

class DomainVerdict:
    @property
    def kind(self) -> str: ...
    @property
    def similarity(self) -> float | None: ...
    @property
    def reason(self) -> str | None: ...
    @property
    def is_out_of_distribution(self) -> bool: ...
    @property
    def coverage_is_unreliable(self) -> bool: ...

class Prediction:
    @property
    def value(self) -> float: ...
    @property
    def interval(self) -> Interval | None: ...
    @property
    def coverage(self) -> float: ...
    @property
    def model(self) -> str: ...
    @property
    def domain(self) -> DomainVerdict: ...
    def __float__(self) -> float:
        """Always raises TypeError. See the module docstring."""
        ...
    def __int__(self) -> int:
        """Always raises TypeError."""
        ...

def predict_translation_rate(utr: str, start_codon: str = ..., host: str = ...) -> Prediction: ...
def predict_translation_rate_batch(
    utrs: list[str], start_codon: str = ..., host: str = ...
) -> list[Prediction]: ...
def scope() -> str: ...
